# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# Search1API endpoint: search (default) | ask.
# Saved admin settings take precedence when persistent configuration is enabled.
# SEARCH1API_ENDPOINT=search

# Tavily search depth: ultra-fast | fast | basic (default) | advanced.
# Saved admin settings take precedence when persistent configuration is enabled.
# Independent of TAVILY_EXTRACT_DEPTH for page content extraction.
# TAVILY_SEARCH_DEPTH=basic
# With WEBSOCKET_MANAGER=redis, room channels require PUBLISH, SUBSCRIBE and
# PSUBSCRIBE permissions plus channel ACLs &socketio and &socketio#*.
# Set false for shared-channel delivery. This must match on every instance;
# changing it requires a full fleet restart, not a rolling restart.
# WEBSOCKET_REDIS_ROOM_CHANNELS=true

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# MFA defaults; saved settings take precedence once persistent config is seeded.
ENABLE_MFA=false
MFA_ALLOW_OAUTH_BYPASS=false
MFA_ALLOW_TRUSTED_HEADER_BYPASS=false

# Optional v0.12 capabilities remain disabled on upgrade.
ENABLE_TOOL_SEARCH=false
AUDIO_REALTIME_ENABLED=false

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to true to add compact row/column stats to parsed CSV retrieval context.
ENABLE_RAG_CSV_SUMMARY=false

# Set to true to preserve backing file records, storage blobs, and per-file vectors when files are removed from knowledge bases.
ENABLE_KNOWLEDGE_FILE_RETENTION=false

# Comma-separated chunk metadata keys to expose to the model alongside retrieved content.
RAG_SOURCE_METADATA_KEYS=''

# Master switch for internal Tools/Functions and external OpenAPI/MCP/Open Terminal plugins.
# All plugin switches require a restart; the master overrides all feature switches.
ENABLE_PLUGINS=true
# Set false to disable workspace Tools and their dependency installation.
ENABLE_TOOLS=true
# Set false to disable Functions (filters, pipes, actions, event functions) and their dependencies.
ENABLE_FUNCTIONS=true
# Set false to disable external tools and terminals, including personal direct connections.
ENABLE_TOOL_SERVERS=true

# WARNING: * trusts forwarded headers from every connection. Use only behind a trusted
# proxy that sanitizes these headers and prevents direct access to the backend.
# Otherwise, set this to the IP addresses or networks of your trusted reverse proxies.
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'

# Context compaction: saved admin configuration takes precedence over these defaults.
# Leave MODE unset to preserve the old ENABLE_CONTEXT_COMPACTION mapping:
# false -> off, true -> legacy. An explicit mode wins; V2 is never enabled on upgrade.
# CONTEXT_COMPACTION_MODE=off  # off | legacy | v2 (set through admin Interface settings)
ENABLE_CONTEXT_COMPACTION=false
CONTEXT_COMPACTION_DEFAULT_CONTEXT_WINDOW=262144
CONTEXT_COMPACTION_V2_EFFECTIVE_WINDOW_PERCENT=95
CONTEXT_COMPACTION_V2_TRIGGER_PERCENT=90
CONTEXT_COMPACTION_V2_REMINDER_PERCENT=10
CONTEXT_COMPACTION_V2_RECENT_TOKENS=20000
# V2 saved-chat tool projections; percentages use the resolved model window C.
# Integers: 1 <= TOOL_RESULT_PERCENT <= TOOL_BATCH_PERCENT <= 100.
# Only newly executed results share these caps; selected history stays fixed.
# Reserve new demand and compact older history first when necessary; reclaim actual summary savings.
# Settings changes affect new decisions, not already selected versions. Disabling restores raw tool text
# after valid V2 history checkpoints. Saved admin settings still override environment defaults.
CONTEXT_COMPACTION_V2_TOOL_BUDGET_ENABLED=true
CONTEXT_COMPACTION_V2_TOOL_RESULT_PERCENT=10
CONTEXT_COMPACTION_V2_TOOL_BATCH_PERCENT=30
# Empty uses built-in task-aware tool-result summary instructions.
CONTEXT_COMPACTION_V2_TOOL_SUMMARY_PROMPT=
# Empty MODEL means current chat model. Empty MAX_OUTPUT_TOKENS inherits summary model output.
# Summary percentage uses the summary model window (including smaller Ollama num_ctx), integer 1..100.
# Choose the larger of percentage tokens and explicit/inherited absolute output, then apply
# model capacity and tool allocation limits. Saved admin values override these environment defaults.
CONTEXT_COMPACTION_V2_MODEL=
CONTEXT_COMPACTION_V2_MAX_OUTPUT_TOKENS=
CONTEXT_COMPACTION_V2_SUMMARY_OUTPUT_PERCENT=5
# Empty prompts use independent V2 defaults; they do not change the legacy prompt.
CONTEXT_COMPACTION_V2_SUMMARY_PROMPT=
CONTEXT_COMPACTION_V2_REMINDER_ENABLED=true
CONTEXT_COMPACTION_V2_REMINDER_PROMPT=
CONTEXT_COMPACTION_V2_TIMEOUT_SECONDS=60
CONTEXT_COMPACTION_V2_MAX_RETRIES=1
